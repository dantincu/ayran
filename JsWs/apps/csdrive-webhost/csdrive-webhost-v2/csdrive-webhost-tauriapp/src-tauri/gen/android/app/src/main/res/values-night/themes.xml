<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.csdrive_webhost_tauriapp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <!-- No white flash while the app starts: the window, and Android 12+'s system splash, use the app's background. -->
