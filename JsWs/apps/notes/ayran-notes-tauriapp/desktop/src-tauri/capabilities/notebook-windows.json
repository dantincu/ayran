{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "notebook-windows",
  "description": "Capabilities for notebook popup windows",
  "windows": ["nb-*"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/c/**" }]
    },
    "core:webview:allow-create-webview-window"
  ]
}
