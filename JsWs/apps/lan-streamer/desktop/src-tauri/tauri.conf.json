{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ayran LAN Streamer",
  "version": "0.1.0",
  "identifier": "io.ayran.lanstreamer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ayran LAN Streamer",
        "width": 900,
        "height": 650
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' https://*:* wss://*:* http://localhost:* ws://localhost:*",
        "media-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
