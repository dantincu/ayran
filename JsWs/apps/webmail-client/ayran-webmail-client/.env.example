# Gmail (Google) OAuth2
VITE_GMAIL_CLIENT_ID=your_gmail_client_id_here

# Outlook (Microsoft) OAuth2
VITE_OUTLOOK_CLIENT_ID=your_outlook_client_id_here

# Yahoo OAuth2
VITE_YAHOO_CLIENT_ID=your_yahoo_client_id_here

# OAuth redirect URI (must match registered redirect URI in each provider)
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback
