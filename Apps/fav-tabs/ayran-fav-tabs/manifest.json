{
  "manifest_version": 3,
  "name": "Ayran Fav Tabs",
  "version": "1.0.0",
  "description": "Remember chosen browser tabs, keep them up to date while you navigate, and manage them from one list.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Remember this tab (right-click: open the list)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["tabs", "storage", "favicon", "contextMenus"],
  "commands": {
    "open-view": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Open the remembered tabs list"
    },
    "toggle-tab": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Remember / forget the current tab"
    }
  }
}
