        <item name="colorOnPrimary">@color/csdrive_on_accent</item>
        <item name="android:windowBackground">@color/csdrive_bg</item>
        <item name="android:windowSplashScreenBackground">@color/csdrive_bg</item>
    </style>
</resources>
