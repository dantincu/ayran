{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to the main window, which loads the user-provided frontend.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",
    "dialog:default",
    "sql:default",
    "sql:allow-execute",
    "allow-keychain-set-secret",
    "allow-keychain-get-secret",
    "allow-keychain-delete-secret"
  ]
}
