# Google OAuth — create a "Desktop application" client at
# https://console.cloud.google.com/apis/credentials
#
# These are read by src-tauri/build.rs and compiled into the Rust binary.
# They are NOT exposed to JavaScript (no VITE_ prefix).
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
