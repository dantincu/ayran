# OAuth client registrations, compiled into the app at build time (see src-tauri/build.rs).
# Copy to .env and fill in. These identify the *app*; no user secret goes here.

# Google Cloud Console -> Credentials -> OAuth client ID -> Application type "Desktop app".
# (Google's loopback flow: the app listens on http://127.0.0.1:<random port>; nothing to register.)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Azure Portal -> App registrations -> Authentication -> "Mobile and desktop applications",
# redirect URI: http://localhost   (any port is accepted for localhost).
# Public client: leave the secret empty.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# consumers (personal accounts only, the default) | common (personal + work/school) | organizations | <tenant id>
OUTLOOK_TENANT=consumers

# Yahoo needs nothing here: it connects over IMAP/SMTP with an app password the user generates.
