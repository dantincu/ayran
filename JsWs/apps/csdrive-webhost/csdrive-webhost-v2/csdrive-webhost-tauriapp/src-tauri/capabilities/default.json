{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to the main window, which loads the user-provided frontend.",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",
    "dialog:default",
    "sql:default",
    "sql:allow-execute",
    "allow-keychain-set-secret",
    "allow-keychain-get-secret",
    "allow-keychain-delete-secret",
    "allow-list-secondary-windows",
    "allow-open-new-secondary-window",
    "allow-add-secondary-window-entry",
    "allow-reopen-secondary-window",
    "allow-close-secondary-window",
    "allow-suspend-secondary-window",
    "allow-close-all-secondary-windows",
    "allow-suspend-all-secondary-windows",
    "allow-focus-secondary-window",
    "allow-add-window-tag",
    "allow-remove-window-tag",
    "allow-get-data-folder-info",
    "allow-pick-and-set-custom-data-folder",
    "allow-reset-data-folder-to-default",
    "allow-clear-custom-data-folder-contents",
    "allow-delete-app-data"
  ]
}
